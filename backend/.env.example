# Placeholders only — real credentials never enter the repo (docs/17 §3).
#
# 走 compose 起栈（infra/docker-compose.yml）时必须显式给三样，仓内不留弱默认：
#   POSTGRES_PASSWORD=…      不给 → postgres 容器启动即失败（Q203 去掉 :-loom 回退）
#   MINIO_ROOT_PASSWORD=…    不给 → minio 容器启动即失败（Q203 去掉 :-minioadmin）
#   LOOM_MASTER_KEY=…        不给 → backend entrypoint 启动即 exit 1（Q200 #33）
# 刻意不用 ${VAR:?}：compose 解析期全局求值会打断没设这些变量的 overlay/彩排（Q185）。
#
# 下面这几行只服务「不经 compose、本机自己起 PG/Redis/MinIO」的开发路径，
# 其中的 loom/minioadmin 是本机开发值，不是任何部署形态的默认。
#
# ⚠️ 载体契约（Q239）：本文件（以及你 cp 出来的 backend/.env）**只能放 Settings
#    字段**（app/core/config.py）。pydantic-settings 默认 extra="forbid"，放一个
#    Settings 不认识的名字——例如 LOOM_LLM_BASE_URL_AGNES——会让 Settings() 抛
#    ValidationError、**整个进程直接起不来**，不是"静默无效"。
#    直接读 os.environ 的变量（LLM base_url、e2e 的 agnes key 等）不放这里，走可
#    source 的 backend/.env.shell：
#        set -a; source backend/.env.shell; set +a
#    因为本仓没有 load_dotenv，pydantic-settings 也只把 .env 读进 Settings 对象、
#    **不会**写进 os.environ ⇒ 那些变量不 source 就等于没设。
#    契约测试：tests/unit/test_env_carrier_contract.py。
LOOM_DATABASE_DSN=postgresql+asyncpg://loom:loom@localhost:5432/loom
LOOM_REDIS_DSN=redis://localhost:6379/0
LOOM_S3_ENDPOINT_URL=http://localhost:9000
LOOM_S3_BUCKET=loom-dev
LOOM_AWS_ACCESS_KEY_ID=minioadmin
LOOM_AWS_SECRET_ACCESS_KEY=minioadmin
