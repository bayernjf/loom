# ─────────────────────────────────────────────────────────────────────────────
# 本机开发/演练用凭证模板 —— 「直接读 os.environ」类变量的可 source 载体。
# 复制为 backend/.env.shell（被 .gitignore 忽略），填入真实值后 source：
#     cp backend/.env.shell.example backend/.env.shell
#     set -a; source backend/.env.shell; set +a
# 本文件只含占位，绝不放真实凭证。
# ─────────────────────────────────────────────────────────────────────────────
#
# 为什么单独一个文件：这些名字不是 Settings 字段，pydantic-settings 默认
# extra="forbid"，放进 .env 会让 Settings() 抛 ValidationError、进程起不来。
# 本仓没有 load_dotenv，不 source 等于没设。

# ── model-hub（W6-1：内置模型/Key 统一由 hub 下发）───────────────────────────
# 配置后：模型注册表写口停用（410），内置模型目录只读，运行时从 hub 投影解析。
# 未配置：保留本地注册表/Key（迁移期/回退）。
MODEL_HUB_URL=http://localhost:8791
MODEL_HUB_TOKEN=replace-with-loom-project-token
# 可选：0600 投影缓存路径（默认 ./data/model-hub-cache.json）。
# MODEL_HUB_CACHE_PATH=./data/model-hub-cache.json
# kill switch：=1/true/yes 停用 hub 接入（保留本地注册表）。
# MODEL_HUB_DISABLED=0

# ── 供应商网关（迁移期保留；hub 全面接入后仅 hub 未配置时使用）────────────────
# 由 app/core/model_registry/drivers.py 从 os.environ 读取。
LOOM_LLM_BASE_URL_AGNES=https://apihub.agnes-ai.com/v1

# 真实 LLM 全链 e2e 演练用（tests/e2e/test_fullchain_golden_path.py）。
LOOM_E2E_AGNES_KEY=replace-with-real-key

# 打开真实 LLM e2e 的开关（默认注释；会真调用、花真金白银）。
# LOOM_E2E_REAL_LLM=1

# ── 内容底座真实产出（M4/T-M4-03）────────────────────────────────────────────
LOOM_LLM_KEY_AGNES=replace-with-real-key
# 内容底座真实模型开关。
LOOM_CONTENT_REAL_LLM=0
LOOM_CONTENT_PROVIDER=agnes
LOOM_CONTENT_MODEL=agnes-3.0-flash
