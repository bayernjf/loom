# infra/.env 模板 —— docker compose 的插值来源（Q203 / Q279 / Q185）。
#
# 用法：
#   cd infra
#   cp .env.example .env
#   # 填下面标 [必填] 的三项；其余按需保留默认
#   docker compose --env-file .env -f docker-compose.yml -f docker-compose.gateway.yml up -d
#
# 纪律：
#   - .env 由 .gitignore 忽略，绝不入库；本模板只放变量名、默认值与生成方式，不放任何真实值。
#   - compose 只做插值：这里写下的变量才会进容器。代码直读 os.environ 的变量（如
#     LOOM_KNOWLEDGE_URL / LOOM_KNOWLEDGE_TOKEN、e2e 的 LOOM_E2E_*）不经过 compose，
#     放在可 source 的 backend/.env.shell，不要写在本文件里。
#   - backend/.env 是另一套载体（pydantic Settings 字段，extra="forbid"），与本文件不互通。
#
# 敏感值生成方式（任选其一，示例用 openssl）：
#   openssl rand -hex 24        # 口令类
#   openssl rand -hex 32        # LOOM_MASTER_KEY（任意高熵口令，代码经 sha256 派生 Fernet key）
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                               # LOOM_MASTER_KEY 的另一种写法：直接给 urlsafe-base64 Fernet key

# ---------------------------------------------------------------------------------------------
# 数据面账号
# ---------------------------------------------------------------------------------------------

# [必填] Postgres 口令。缺失时 postgres 容器启动即失败（Q203 已去掉弱默认）。
POSTGRES_PASSWORD=

# Postgres 用户名与库名。默认：loom / loom
POSTGRES_USER=loom
POSTGRES_DB=loom

# [必填] MinIO 根口令（对象存储与 WAL 归档共用）。缺失时 minio 容器启动即失败。
MINIO_ROOT_PASSWORD=

# MinIO 根用户名。默认：minioadmin
MINIO_ROOT_USER=minioadmin

# ---------------------------------------------------------------------------------------------
# 应用必填项
# ---------------------------------------------------------------------------------------------

# [必填] 出站供应商 Key 的加密主密钥。缺失时 backend entrypoint 打印 FATAL 并 exit 1。
# 已用旧主密钥加密落库的 Key 在新主密钥下不可解 —— 轮换前先迁移/重录，不能只改这一行。
LOOM_MASTER_KEY=

# ---------------------------------------------------------------------------------------------
# 对外域名（gateway overlay）
# ---------------------------------------------------------------------------------------------

# Caddy 站点地址。默认：loom.bayjf.com（Caddyfile 内同值，两处必须一致，见
# tests/unit/test_gateway_surface_contract.py）。
LOOM_GATEWAY_DOMAIN=loom.bayjf.com

# A2A 卡片对外基址（拼 agent card 的 url）。必须与 LOOM_GATEWAY_DOMAIN **同域**，
# 异域时网关演练预检 exit 2（Q287）。留空＝卡片输出相对路径。
LOOM_PUBLIC_BASE_URL=https://loom.bayjf.com

# ---------------------------------------------------------------------------------------------
# 身份门控
# ---------------------------------------------------------------------------------------------

# staff 人员令牌门控。compose 默认 true（评审 P1-2，2026-11-02）；代码默认 false 只服务
# 不经 compose 的本地 V1 兼容面。
# 首次部署不必临时置 false：用 backend/scripts/bootstrap_staff_key.py 直接签首令牌即可
# （docs/17 §1.3 第 3 步）。门控开而库里没有 active 令牌时 backend 启动 fail-fast，
# 报错会点名该脚本。置 false 只在回滚时需要，等于恢复自报身份。
LOOM_STAFF_AUTH_ENABLED=true

# ---------------------------------------------------------------------------------------------
# 后台作业与功能开关（除 scheduler 外默认关，V1 行为不变）
# ---------------------------------------------------------------------------------------------

# SLA sweep 等周期作业总闸。默认：true
LOOM_SCHEDULER_ENABLED=true

# discarded 记录物理清理。默认：false
LOOM_DISCARD_PURGE_ENABLED=false

# MCP 对外面。默认：false
LOOM_MCP_ENABLED=false

# 段 8 每周重算提醒（只开运营待办）。默认：false
LOOM_PCP_WEEKLY_SCAN_ENABLED=false

# 段 7 fit_score 自学习 advisory。默认：false
LOOM_FIT_LEARNING_ENABLED=false

# 段 12 真视频生成（供应商异步任务，需逐单人工 approve）。默认：false
LOOM_VIDEO_REAL_ENABLED=false

# 出站模型端点（仅 endpoint，出站 Key 加密存库、不进 env）。留空＝沿用代码默认。
LOOM_LLM_BASE_URL_OPENAI=

# ---------------------------------------------------------------------------------------------
# 前端默认身份（V1 无登录，服务端自报；V2 认证上线后改由会话派生）
# ---------------------------------------------------------------------------------------------

LOOM_TENANT_ID=beta-tenant
LOOM_ACTOR_ID=ops-actor
LOOM_ADMIN_ACTOR_ID=admin-actor
# 多角色逗号分隔。默认：platform_admin（Q314 统一审核台读口依赖该默认身份开屏）
LOOM_ADMIN_ROLES=platform_admin

# ---------------------------------------------------------------------------------------------
# 备份与 WAL 归档（base compose）
# ---------------------------------------------------------------------------------------------

# pg_dump 保留天数。默认：7
BACKUP_RETENTION_DAYS=7
# pg_dump 间隔（秒）。默认：86400
BACKUP_INTERVAL_SECONDS=86400
# basebackup 间隔（秒）。默认：86400
BASEBACKUP_INTERVAL_SECONDS=86400
# WAL 推送到 MinIO 的间隔（秒）。默认：60
WAL_ARCHIVE_INTERVAL_SECONDS=60
# WAL 桶名。默认：loom-wal
WAL_BUCKET=loom-wal

# ---------------------------------------------------------------------------------------------
# 监控与告警
# ---------------------------------------------------------------------------------------------

# watchdog 轮询间隔（秒）。默认：30
WATCHDOG_INTERVAL_SECONDS=30

# 告警 webhook（watchdog 转发目标）。留空＝只写日志不投递。
LOOM_ALERT_WEBHOOK=

# [必填·仅 monitoring overlay] Grafana 管理员口令。刻意无默认值：
# 缺失时 `--profile monitoring` 在 compose 解析期直接报错（不会静默起一个弱口令看板）。
LOOM_GRAFANA_ADMIN_PASSWORD=
