{
  "uid": "loom-operations",
  "title": "Loom 业务信号（Q188）",
  "description": "作业失败 / 队列积压 / leader 租约易主 / 模型上游延迟与预算硬停。只面板化 app/core/metrics/business.py 真实注册的序列。",
  "tags": [
    "loom",
    "q188"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "作业进入 failed（按域）",
      "datasource": {
        "type": "prometheus",
        "uid": "loom-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "loom-prom"
          },
          "expr": "sum by (kind) (increase(loom_job_failed_total[15m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "死信（按流）",
      "datasource": {
        "type": "prometheus",
        "uid": "loom-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "loom-prom"
          },
          "expr": "sum by (stream) (increase(loom_stream_dead_letters_total[15m]))",
          "legendFormat": "{{stream}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "消费组未 ACK 深度（XPENDING）",
      "datasource": {
        "type": "prometheus",
        "uid": "loom-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "loom-prom"
          },
          "expr": "loom_stream_pending",
          "legendFormat": "{{stream}} / {{group}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "流长度（XLEN，超过约 10000 开始裁剪）",
      "datasource": {
        "type": "prometheus",
        "uid": "loom-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "loom-prom"
          },
          "expr": "loom_stream_length",
          "legendFormat": "{{stream}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "模型上游 P99 耗时（仅成功调用）",
      "datasource": {
        "type": "prometheus",
        "uid": "loom-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "loom-prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le, scene) (rate(loom_llm_upstream_duration_seconds_bucket{outcome=\"ok\"}[10m])))",
          "legendFormat": "{{scene}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "模型上游调用速率（按场景/成败）",
      "datasource": {
        "type": "prometheus",
        "uid": "loom-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "loom-prom"
          },
          "expr": "sum by (scene, outcome) (rate(loom_llm_upstream_duration_seconds_count[10m]))",
          "legendFormat": "{{scene}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "leader 租约判丢（近 1 小时）",
      "datasource": {
        "type": "prometheus",
        "uid": "loom-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "loom-prom"
          },
          "expr": "sum(increase(loom_lock_lost_total[1h]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "模型日预算硬停（近 1 小时）",
      "datasource": {
        "type": "prometheus",
        "uid": "loom-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "loom-prom"
          },
          "expr": "sum(increase(loom_llm_budget_blocked_total[1h]))",
          "legendFormat": ""
        }
      ]
    }
  ]
}
